# Environment: demo (ASPNETCORE_ENVIRONMENT=Demo)
# The public demo kurin. Seeds the same demo data as dev, lets visitors in without a password
# from the login page (POST api/demo/login — the controller exists only on this tier), and puts the
# database back to the seeded state every night at 03:00 UTC (DemoResetBackgroundService).
# Hosted apart from production: nothing here is real, and nothing here must be able to reach
# anything that is.
PROJECTK_ENV=demo
PROJECTK_ASPNETCORE_ENV=Demo
PROJECTK_NG_CONFIG=production

PROJECTK_WEB_PORT=4220
PROJECTK_API_PORT=5255

PROJECTK_API_URL=http://localhost:5255/api
PROJECTK_ENVIRONMENT_NAME=Demo
PROJECTK_PUBLIC_URL=http://localhost:4220
PROJECTK_CORS_ORIGIN=http://localhost:4220

# Privileged-MFA bypass: the demo Звʼязковий has no phone to pair. MfaEnforcementPolicy ignores
# this flag in Staging and Production, so it cannot leak there.
PROJECTK_BYPASS_MFA=true

PROJECTK_DB_CONNECTION_STRING=Server=projectk-sql,1433;Database=projectK_demo;User Id=sa;Password=Change_this_SQL_password_123!;TrustServerCertificate=True;Encrypt=False;

PROJECTK_BLOB_CONTAINER=photos
PROJECTK_BLOB_PUBLIC_BASE_URL=http://localhost:10000/devstoreaccount1/photos
PROJECTK_BLOB_CONNECTION_STRING=UseDevelopmentStorage=true;DevelopmentStorageProxyUri=http://projectk-azurite

# Local docker stand only. A hosted demo is a public tier: give it a real key via PROJECTK_JWT_KEY.
PROJECTK_JWT_KEY=local-docker-demo-stand-signing-key-not-for-hosting-32
PROJECTK_JWT_ISSUER=ProjectK-Backend
PROJECTK_JWT_AUDIENCE=ProjectK-Users

# NuGet auth for building the API image is read from your HOST env var
# NUGET_AUTH_TOKEN. Do NOT put a token in this committed file. See docker/README.md.

PROJECTK_API_IMAGE=
PROJECTK_WEB_IMAGE=
