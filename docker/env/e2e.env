# Environment: e2e (ASPNETCORE_ENVIRONMENT=E2E)
# Isolated database for Playwright/e2e runs against the shared tooling.
PROJECTK_ENV=e2e
PROJECTK_ASPNETCORE_ENV=E2E
PROJECTK_NG_CONFIG=development

PROJECTK_WEB_PORT=4201
PROJECTK_API_PORT=5206

PROJECTK_API_URL=http://localhost:5206/api
PROJECTK_ENVIRONMENT_NAME=E2E
PROJECTK_PUBLIC_URL=http://localhost:4201
PROJECTK_CORS_ORIGIN=http://localhost:4201

PROJECTK_DB_CONNECTION_STRING=Server=projectk-sql,1433;Database=projectK_e2e;User Id=sa;Password=Change_this_SQL_password_123!;TrustServerCertificate=True;Encrypt=False;

# Privileged-MFA bypass: compose defaults this to false, which overrides appsettings.E2E.json.
# The Playwright suite signs in as admin/manager, so it must be on for this env only.
PROJECTK_BYPASS_MFA=true

# Web Push: a THROWAWAY TEST-ONLY VAPID key pair, generated for the e2e stack and published here on
# purpose. Never use it anywhere else; real deployments generate their own pair.
PROJECTK_WEBPUSH_PUBLIC_KEY=BDeLW-FFPXDIu7DhSQo_OnzzEmrLljJO2-0bszZ5cxFscIcrosM2WTzjOGuZZOCWwujNEObZm0iLGconJxSdIcg
PROJECTK_WEBPUSH_PRIVATE_KEY=9sbYUFXSOOuBssD0Mem-ltekXR7cgcPk7uluQJff8bw
PROJECTK_WEBPUSH_SUBJECT=mailto:e2e@example.com

PROJECTK_BLOB_CONTAINER=photos
PROJECTK_BLOB_PUBLIC_BASE_URL=http://localhost:10000/devstoreaccount1/photos
PROJECTK_BLOB_CONNECTION_STRING=UseDevelopmentStorage=true;DevelopmentStorageProxyUri=http://projectk-azurite

PROJECTK_JWT_KEY=local-e2e-jwt-key-change-me-please-at-least-32chars
PROJECTK_JWT_ISSUER=ProjectK-Backend
PROJECTK_JWT_AUDIENCE=ProjectK-Users

# NuGet auth for building the API image is read from your HOST env var
# NUGET_AUTH_TOKEN. Do NOT put a token in this committed file. See docker/README.md.

PROJECTK_API_IMAGE=
PROJECTK_WEB_IMAGE=
