# Environment: tailscale (ASPNETCORE_ENVIRONMENT=Tailscale)
# LAN/Tailnet access. A stand for people, not a demo: the seeder does not touch this tier, so
# whatever is entered here survives `dev.sh up` (STAB-07). A fresh database gets its first
# administrator through the setup wizard at /setup, the way production does.
# Every URL below is this host's Tailscale address (spulivan-pc,
# 100.64.66.7) so the stack answers the same way from every device on the tailnet.
#
# CORS takes a single origin (see EnvCorsOrigin in Program.cs), so this address is the
# one to open the app by — on this machine too. localhost:4210 serves the page but the
# API call from it is refused.
PROJECTK_ENV=tailscale
PROJECTK_ASPNETCORE_ENV=Tailscale
PROJECTK_NG_CONFIG=tailscale

PROJECTK_WEB_PORT=4210
PROJECTK_API_PORT=5225
# The docs site (site/, Astro) beside the app: http://100.64.66.7:4230. Setting the port is what
# turns the compose profile on; leave it unset on tiers that do not need the docs.
PROJECTK_DOCS_PORT=4230

PROJECTK_API_URL=http://100.64.66.7:5225/api
PROJECTK_ENVIRONMENT_NAME=Tailscale
PROJECTK_PUBLIC_URL=http://100.64.66.7:4210
PROJECTK_CORS_ORIGIN=http://100.64.66.7:4210

# Privileged-MFA bypass. Without it every non-GET request by an admin or Зв'язковий is 403
# until that account enables two-factor — the stack reads fine and changes nothing, and each
# button reports its own «спробуй ще раз». This is a LAN tier, so the bypass is allowed;
# MfaEnforcementPolicy ignores it outright in Staging and Production.
PROJECTK_BYPASS_MFA=true

PROJECTK_DB_CONNECTION_STRING=Server=projectk-sql,1433;Database=projectK_tailscale;User Id=sa;Password=Change_this_SQL_password_123!;TrustServerCertificate=True;Encrypt=False;

PROJECTK_BLOB_CONTAINER=photos
# Photos are served straight from Azurite to the browser, so this one has to be the
# tailnet address as well — on localhost every avatar would break off this machine.
PROJECTK_BLOB_PUBLIC_BASE_URL=http://100.64.66.7:10000/devstoreaccount1/photos
PROJECTK_BLOB_CONNECTION_STRING=UseDevelopmentStorage=true;DevelopmentStorageProxyUri=http://projectk-azurite

PROJECTK_JWT_KEY=local-tailscale-jwt-key-11092025-EXTRACHARS-40
PROJECTK_JWT_ISSUER=ProjectK-Backend
PROJECTK_JWT_AUDIENCE=ProjectK-Users

# NuGet auth for building the API image is read from your HOST env var
# NUGET_AUTH_TOKEN. Do NOT put a token in this committed file. See docker/README.md.

PROJECTK_API_IMAGE=
PROJECTK_WEB_IMAGE=
