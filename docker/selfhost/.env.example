PROJECTK_VERSION=0.14.2-beta

# The address people open the app by. With a reverse proxy and a domain in front, all three are
# that domain (https://plast.example.org); PROJECTK_API_URL stays relative, nginx inside the web
# container forwards /api to the API.
PROJECTK_PUBLIC_URL=http://localhost:8080
PROJECTK_API_URL=/api
PROJECTK_CORS_ORIGIN=http://localhost:8080
PROJECTK_ENVIRONMENT_NAME=Self-Host

# The only port the bundle publishes on the host. The API, SQL Server and the blob store stay on
# the compose network and are reached through this one.
PROJECTK_WEB_PORT=8080

# REQUIRED. At least 32 random characters; the API refuses to start with this example value.
#   Linux/macOS:  openssl rand -base64 48
#   PowerShell:   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
PROJECTK_JWT_KEY=replace-this-with-at-least-32-random-characters
PROJECTK_JWT_ISSUER=ProjectK-Backend
PROJECTK_JWT_AUDIENCE=ProjectK-Users

# REQUIRED. SQL Server insists on a strong password; put the same value in the connection string.
PROJECTK_SQL_PASSWORD=Change_this_SQL_password_123!
PROJECTK_SQL_EDITION=Developer
PROJECTK_DB_CONNECTION_STRING=Server=projectk-sql,1433;Database=projectK;User Id=sa;Password=Change_this_SQL_password_123!;TrustServerCertificate=True;Encrypt=False;

# Photos are public blobs read by the browser. The URL is PROJECTK_PUBLIC_URL plus /blob/... —
# change the host part together with PROJECTK_PUBLIC_URL.
PROJECTK_BLOB_CONTAINER=photos
PROJECTK_BLOB_PUBLIC_BASE_URL=http://localhost:8080/blob/devstoreaccount1/photos
PROJECTK_BLOB_CONNECTION_STRING=UseDevelopmentStorage=true;DevelopmentStorageProxyUri=http://projectk-azurite

# Required only when building images locally and restoring private GitHub NuGet packages.
PROJECTK_NUGET_AUTH_TOKEN=
